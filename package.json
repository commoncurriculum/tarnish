{
  "name": "tarnish-harness",
  "private": true,
  "type": "module",
  "scripts": {
    "build:bridge": "node harness/build.mjs",
    "test:js": "TARNISH_TARGET=js node harness/run.mjs && node harness/record-model.mjs && node harness/record-steps.mjs && node harness/record-ops.mjs && node harness/record-dom.mjs",
    "test:rust": "npm run build:bridge && TARNISH_TARGET=rust node harness/run.mjs",
    "test:c": "node harness/test-c.mjs",
    "bench": "node bench/document.mjs && node bench/prosemirror.mjs"
  },
  "devDependencies": {
    "ist": "1.1.7",
    "linkedom": "github:commoncurriculum/linkedom#345ef3f3298ae3e3703374f653f80790b0af324b",
    "mocha": "10.8.2",
    "orderedmap": "2.1.1",
    "prosemirror-model": "1.25.11",
    "prosemirror-schema-basic": "1.2.4",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-test-builder": "1.1.1",
    "prosemirror-transform": "1.12.0",
    "tsx": "4.19.2"
  }
}
